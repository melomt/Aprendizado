    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var estado = null;
var cidade = null;

if (location != null) {
    // Procura por exatamente 2 letras maiúsculas (a sigla do estado)
    var reg = /\b[A-Z]{2}\b/;
    var match = location.match(reg);
    
    var temp_cidade = location; // Começa copiando o texto original
    
    if (match != null &amp;&amp; match.length > 0) {
        estado = match[0]; // Salva o estado encontrado
        
        // Remove a sigla do estado do texto original
        temp_cidade = temp_cidade.replace(estado, "");
    }
    
    // 1. Remove as vírgulas, barras e traços que sobraram
    temp_cidade = temp_cidade.replace(/[\/\-\,]/g, "");
    
    // 2. NOVO: Remove os parênteses e TUDO que estiver dentro deles
    temp_cidade = temp_cidade.replace(/\([^)]*\)/g, "");
    
    // 3. Remove os espaços em branco no começo ou no final
    cidade = temp_cidade.trim();
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>estado</name>
        <rename>estado</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>cidade</name>
        <rename>cidade</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>JavaScript 2</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
