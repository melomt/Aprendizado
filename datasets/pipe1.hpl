    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

// Captura o campo que vem do fluxo
var dataOriginal = start_date;
var start_date_final = "";

if (dataOriginal != null &amp;&amp; dataOriginal != "") {
    // Se for texto no formato DD/MM/YYYY, vamos apenas reorganizar as peças
    // Isso evita o erro de conversão de formato do Java
    var partes = String(dataOriginal).split("/");
    
    if (partes.length == 3) {
        // Monta o padrão YYYY-MM-DD (ISO)
        start_date_final = partes[2] + "-" + partes[1] + "-" + partes[0];
    } else {
        // Se já estiver no formato certo ou outro, mantém como está
        start_date_final = dataOriginal;
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>start_date_final</name>
        <rename>start_date_final</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>512</yloc>
    </GUI>
