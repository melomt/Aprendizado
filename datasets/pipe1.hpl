  <transform>
    <name>Limpa_catepgora</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var category = actual_category;

if (actual_category != null) {
    // Tira TODOS os espaços em branco e joga para maiúsculo
    var texto_limpo = actual_category.toUpperCase().replace(/\s/g, "");
    
    // Procura as raízes das palavras na string limpa
    if (texto_limpo.match(/ELETR/)) {
        category = "Eletrônicos";
        
    // Encurtamos a raiz para pegar PROP, PROPULÇÃO, PROPUÇÃO, etc.
    } else if (texto_limpo.match(/PROP/)) {
        category = "Propulsão";
        
    // A barra em pé (|) significa "OU" em Regex
    } else if (texto_limpo.match(/ENCOR|ANCOR/)) {
        category = "Ancoragem"; 
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>category</name>
        <rename>category</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>texto_limpo</name>
        <rename>texto_limpo</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
